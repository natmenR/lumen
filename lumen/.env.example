# ===== Lumen · configuración =====
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de datos (Neon). Si falla por channel_binding, quita "&channel_binding=require"
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

JWT_SECRET=cambia-esto-por-un-secreto-largo
DEMO_PASSWORD=Lumen123*

# Reglas de negocio
OFFER_TTL_MINUTES=5
REQUEST_TTL_MINUTES=30

# Muestra el enlace de recuperación en pantalla cuando no hay SMTP (solo demo)
EXPOSE_RESET_LINK=true

# Videollamada integrada (Jitsi). Puedes usar tu propio dominio.
JITSI_DOMAIN=meet.jit.si

# Opcionales: correo (SMTP), WhatsApp/SMS (Twilio) e IA generativa (Anthropic)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lumen <no-reply@lumen.app>"
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
